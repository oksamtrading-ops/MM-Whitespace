# Copy to .env.local and fill in. .env.local is git-ignored; this file is not,
# so it carries names and never values.

# --- database ------------------------------------------------------------
# Unset: SQLite at MM_DATABASE. Set: Postgres, and nothing else changes.
# MM_DATABASE_URL=postgresql://...
MM_DATABASE=./period.db
# A private certificate authority, if a deployment terminates TLS with one.
# MM_DATABASE_CA=/path/to/ca.pem

# --- sign-in -------------------------------------------------------------
# session (magic link, the default) | dev (three local accounts) | session+dev
MM_AUTH=session
# Who may be invited at all. Invite-only is the real gate: an address with no
# row in app_users is not a user, whatever the mail provider says.
MM_ALLOWED_DOMAINS=deloitte.ca
# The origin that goes into the sign-in link. Set this in a deployment: a Host
# header is attacker-controlled and this string is a link people click.
# MM_PUBLIC_URL=https://whitespace.example
# Bounds. Expiry cannot be extended by use; idle closes an unattended laptop.
# MM_SESSION_HOURS=12
# MM_SESSION_IDLE_HOURS=4
# MM_LINK_TTL_SECONDS=900

# --- mail ----------------------------------------------------------------
# resend | log (prints the link; refuses to run in production)
MM_MAIL=log
# MM_RESEND_KEY=re_...
# MM_MAIL_FROM=Whitespace <no-reply@example>

# --- operations ----------------------------------------------------------
# Shared by the cron tick and the worker endpoint. On Vercel, CRON_SECRET must
# hold the same value: that is what the scheduler presents.
MM_CRON_SECRET=
# Whether this deployment may research, and how. Unset: it may not, and the
# run screen says so. replay: recorded fixtures only, nothing is sent
# anywhere. live: the model vendor, once LIVE_ENABLED is true in the build.
# MM_ENRICH_MODE=replay
# Where recordings live in replay mode. Default: tests/cassettes.
# MM_CASSETTE_DIR=tests/cassettes
# Live mode only. The model vendor's key, from a workspace with its own spend
# limit (docs/decisions/S3-ACCOUNT-LIMITS.md, step 3).
# ANTHROPIC_API_KEY=
# Live mode only. SEC EDGAR's fair-access policy requires a contact email in
# the User-Agent and refuses requests without one.
# MM_SEC_CONTACT=someone@example.com
# --- the Python functions ------------------------------------------------
# The upload parser (api/parse.py) and the export builder (api/export.py) run
# beside the app because Vercel's Node functions have no Python. Both authorise
# with this one shared secret -- the application talking to itself. Locally
# neither is called: python3 runs as a subprocess instead.
# MM_PARSE_SECRET=
# Where they answer, if not this deployment's own /api/parse and /api/export.
# MM_PARSE_URL=
# MM_EXPORT_URL=

# Development sign-in only; MM_AUTH=dev or session+dev.
MM_DEV_AUTH_SECRET=
